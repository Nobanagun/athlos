# Athlos backend - environment variables (placeholder)
# Sin valores reales todavia. Se completara cuando se defina la capa de
# infraestructura (base de datos, broker de mensajeria, proveedores externos).

ATHLOS_ENV=development
ATHLOS_DEBUG=true

# Database - required to run the app (api.dependencies.get_session()
# raises a clear RuntimeError if unset). No real Postgres service is up
# yet (Fase 1 Docker pending) - tests use SQLite via dependency overrides
# instead, so DATABASE_URL is not needed to run the test suite.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/athlos

# JWT signing secret (HS256, symmetric) - required to run the app
# (identity.interfaces.dependencies raises a clear RuntimeError if
# unset). Tests set their own value via monkeypatch/env, independent of
# this file. Generate a real one with e.g. `openssl rand -hex 32` - never
# commit a real value here.
# JWT_SECRET=

# CORS - browser origins allowed to call this API, comma-separated.
# Empty/unset means no browser origin is allowed - native iOS/Android
# traffic is unaffected (CORS only applies to browser fetch/XHR), so
# this is only needed to test the Expo Web build locally. Never set to
# "*": that would let any website call authenticated endpoints from a
# user's browser.
# CORS_ALLOWED_ORIGINS=http://localhost:8081

# External integrations (TBD)
# GARMIN_CLIENT_ID=
# STRAVA_CLIENT_ID=
# WHOOP_CLIENT_ID=
# TRAININGPEAKS_CLIENT_ID=
# HEVY_CLIENT_ID=
